Cost Breakdown HTML Card = 

VAR Destination =
    SELECTEDVALUE(
        DimDestination[City],
        "Selected Destination"
    )

VAR Traveller =
    SELECTEDVALUE(
        DimTravellerType[TravellerType],
        "All Travellers"
    )


/* =========================================================
   COST COMPONENTS
   ========================================================= */

VAR Flight =
    [Avg Flight Cost]

VAR Accommodation =
    [Avg Accommodation Cost]

VAR Food =
    [Avg Food Cost]

VAR Transport =
    [Avg Local Transport Cost]

VAR Attractions =
    [Avg Attraction Cost]

VAR TouristTax =
    [Avg Tourist Tax]

VAR TotalCost =
    [Avg Holiday Cost]


/* =========================================================
   COST PERCENTAGES
   ========================================================= */

VAR FlightPct =
    DIVIDE(Flight, TotalCost)

VAR AccommodationPct =
    DIVIDE(Accommodation, TotalCost)

VAR FoodPct =
    DIVIDE(Food, TotalCost)

VAR TransportPct =
    DIVIDE(Transport, TotalCost)

VAR AttractionsPct =
    DIVIDE(Attractions, TotalCost)

VAR TouristTaxPct =
    DIVIDE(TouristTax, TotalCost)


/* =========================================================
   DISPLAY VALUES
   ========================================================= */

VAR FlightDisplay =
    "€" & FORMAT(Flight, "#,##0")

VAR AccommodationDisplay =
    "€" & FORMAT(Accommodation, "#,##0")

VAR FoodDisplay =
    "€" & FORMAT(Food, "#,##0")

VAR TransportDisplay =
    "€" & FORMAT(Transport, "#,##0")

VAR AttractionsDisplay =
    "€" & FORMAT(Attractions, "#,##0")

VAR TouristTaxDisplay =
    "€" & FORMAT(TouristTax, "#,##0")

VAR TotalDisplay =
    "€" & FORMAT(TotalCost, "#,##0")


/* =========================================================
   PERCENTAGE DISPLAY
   ========================================================= */

VAR FlightPctDisplay =
    FORMAT(FlightPct, "0%")

VAR AccommodationPctDisplay =
    FORMAT(AccommodationPct, "0%")

VAR FoodPctDisplay =
    FORMAT(FoodPct, "0%")

VAR TransportPctDisplay =
    FORMAT(TransportPct, "0%")

VAR AttractionsPctDisplay =
    FORMAT(AttractionsPct, "0%")

VAR TouristTaxPctDisplay =
    FORMAT(TouristTaxPct, "0%")


/* =========================================================
   COST DRIVER
   ========================================================= */

VAR MaxCost =
    MAX(
        MAX(
            MAX(
                Flight,
                Accommodation
            ),
            MAX(
                Food,
                Transport
            )
        ),
        MAX(
            Attractions,
            TouristTax
        )
    )


VAR MainCostDriver =
    SWITCH(
        TRUE(),

        MaxCost = Flight,
            "Flights",

        MaxCost = Accommodation,
            "Accommodation",

        MaxCost = Food,
            "Food",

        MaxCost = Transport,
            "Local Transport",

        MaxCost = Attractions,
            "Attractions",

        "Tourist Tax"
    )


VAR DriverAmount =
    MaxCost

VAR DriverPct =
    DIVIDE(
        DriverAmount,
        TotalCost
    )


/* =========================================================
   COST INSIGHT
   ========================================================= */

VAR CostInsight =
    SWITCH(
        TRUE(),

        MainCostDriver = "Accommodation",
            "Accommodation is the largest contributor to the average holiday cost.",

        MainCostDriver = "Flights",
            "Flights are the largest contributor to the average holiday cost.",

        MainCostDriver = "Food",
            "Food represents the largest share of the average holiday budget.",

        MainCostDriver = "Local Transport",
            "Local transport is the largest contributor to the average holiday cost.",

        MainCostDriver = "Attractions",
            "Attractions represent the largest share of the average holiday budget.",

        "Tourist tax represents the largest share of the average holiday budget."
    )


/* =========================================================
   RETURN HTML
   ========================================================= */

RETURN

"
<div class='cost-card'>


    <!-- =====================================================
         HEADER
         ===================================================== -->

    <div class='cost-header'>


        <div class='header-left'>

            <div class='header-accent'></div>

            <div>

                <div class='header-title'>
                    COST BREAKDOWN
                </div>

                <div class='header-subtitle'>
                    Where does the money go?
                </div>

            </div>

        </div>


        <div class='context'>

            <div class='context-label'>
                DESTINATION
            </div>

            <div class='context-value'>
                " & UPPER(Destination) & "
            </div>

            <div class='context-traveller'>
                " & Traveller & "
            </div>

        </div>


    </div>



    <!-- =====================================================
         TOTAL COST HERO
         ===================================================== -->

    <div class='total-section'>


        <div class='total-left'>

            <div class='total-icon'>
                €
            </div>

            <div>

                <div class='total-label'>
                    AVERAGE HOLIDAY COST
                </div>

                <div class='total-value'>
                    " & TotalDisplay & "
                </div>

                <div class='total-caption'>
                    Average total holiday cost for the current selection
                </div>

            </div>

        </div>


        <div class='driver-box'>

            <div class='driver-label'>
                LARGEST COST DRIVER
            </div>

            <div class='driver-name'>
                " & MainCostDriver & "
            </div>

            <div class='driver-value'>
                " & FORMAT(DriverPct, "0%") & "
                <span>of total</span>
            </div>

        </div>


    </div>



    <!-- =====================================================
         COST BREAKDOWN
         ===================================================== -->

    <div class='breakdown'>


        <!-- FLIGHT -->

        <div class='cost-row'>

            <div class='cost-icon flight-icon'>
                ✈
            </div>

            <div class='cost-info'>

                <div class='cost-name'>
                    Flight
                </div>

                <div class='cost-bar'>

                    <div
                        class='bar-fill flight-fill'
                        style='width:"
                            &
                            FORMAT(
                                MIN(
                                    MAX(
                                        FlightPct * 100,
                                        0
                                    ),
                                    100
                                ),
                                "0"
                            )
                            &
                        "%;'>
                    </div>

                </div>

            </div>

            <div class='cost-value'>

                <div>
                    " & FlightDisplay & "
                </div>

                <span>
                    " & FlightPctDisplay & "
                </span>

            </div>

        </div>



        <!-- ACCOMMODATION -->

        <div class='cost-row'>

            <div class='cost-icon hotel-icon'>
                🏨
            </div>

            <div class='cost-info'>

                <div class='cost-name'>
                    Accommodation
                </div>

                <div class='cost-bar'>

                    <div
                        class='bar-fill hotel-fill'
                        style='width:"
                            &
                            FORMAT(
                                MIN(
                                    MAX(
                                        AccommodationPct * 100,
                                        0
                                    ),
                                    100
                                ),
                                "0"
                            )
                            &
                        "%;'>
                    </div>

                </div>

            </div>

            <div class='cost-value'>

                <div>
                    " & AccommodationDisplay & "
                </div>

                <span>
                    " & AccommodationPctDisplay & "
                </span>

            </div>

        </div>



        <!-- FOOD -->

        <div class='cost-row'>

            <div class='cost-icon food-icon'>
                🍴
            </div>

            <div class='cost-info'>

                <div class='cost-name'>
                    Food
                </div>

                <div class='cost-bar'>

                    <div
                        class='bar-fill food-fill'
                        style='width:"
                            &
                            FORMAT(
                                MIN(
                                    MAX(
                                        FoodPct * 100,
                                        0
                                    ),
                                    100
                                ),
                                "0"
                            )
                            &
                        "%;'>
                    </div>

                </div>

            </div>

            <div class='cost-value'>

                <div>
                    " & FoodDisplay & "
                </div>

                <span>
                    " & FoodPctDisplay & "
                </span>

            </div>

        </div>



        <!-- TRANSPORT -->

        <div class='cost-row'>

            <div class='cost-icon transport-icon'>
                🚆
            </div>

            <div class='cost-info'>

                <div class='cost-name'>
                    Local Transport
                </div>

                <div class='cost-bar'>

                    <div
                        class='bar-fill transport-fill'
                        style='width:"
                            &
                            FORMAT(
                                MIN(
                                    MAX(
                                        TransportPct * 100,
                                        0
                                    ),
                                    100
                                ),
                                "0"
                            )
                            &
                        "%;'>
                    </div>

                </div>

            </div>

            <div class='cost-value'>

                <div>
                    " & TransportDisplay & "
                </div>

                <span>
                    " & TransportPctDisplay & "
                </span>

            </div>

        </div>



        <!-- ATTRACTIONS -->

        <div class='cost-row'>

            <div class='cost-icon attraction-icon'>
                ★
            </div>

            <div class='cost-info'>

                <div class='cost-name'>
                    Attractions
                </div>

                <div class='cost-bar'>

                    <div
                        class='bar-fill attraction-fill'
                        style='width:"
                            &
                            FORMAT(
                                MIN(
                                    MAX(
                                        AttractionsPct * 100,
                                        0
                                    ),
                                    100
                                ),
                                "0"
                            )
                            &
                        "%;'>
                    </div>

                </div>

            </div>

            <div class='cost-value'>

                <div>
                    " & AttractionsDisplay & "
                </div>

                <span>
                    " & AttractionsPctDisplay & "
                </span>

            </div>

        </div>



        <!-- TOURIST TAX -->

        <div class='cost-row'>

            <div class='cost-icon tax-icon'>
                %
            </div>

            <div class='cost-info'>

                <div class='cost-name'>
                    Tourist Tax
                </div>

                <div class='cost-bar'>

                    <div
                        class='bar-fill tax-fill'
                        style='width:"
                            &
                            FORMAT(
                                MIN(
                                    MAX(
                                        TouristTaxPct * 100,
                                        0
                                    ),
                                    100
                                ),
                                "0"
                            )
                            &
                        "%;'>
                    </div>

                </div>

            </div>

            <div class='cost-value'>

                <div>
                    " & TouristTaxDisplay & "
                </div>

                <span>
                    " & TouristTaxPctDisplay & "
                </span>

            </div>

        </div>


    </div>



    <!-- =====================================================
         INSIGHT
         ===================================================== -->

    <div class='cost-insight'>


        <div class='insight-icon'>
            💡
        </div>


        <div class='insight-content'>

            <div class='insight-label'>
                COST INSIGHT
            </div>

            <div class='insight-title'>
                " & MainCostDriver & "
                drives the budget
            </div>

            <div class='insight-description'>
                " & CostInsight & "
            </div>

        </div>


        <div class='insight-number'>

            " & FORMAT(DriverPct, "0%") & "

            <span>
                OF TOTAL
            </span>

        </div>


    </div>


</div>



<style>


/* =========================================================
   GLOBAL
   ========================================================= */

* {
    box-sizing: border-box;
}


/* =========================================================
   MAIN CARD
   ========================================================= */

.cost-card {

    width: 100%;

    height: 100%;

    min-height: 620px;

    padding: 28px;

    font-family:
        Segoe UI,
        Arial,
        sans-serif;

    color: #ffffff;

    background:
        linear-gradient(
            145deg,
            #063c51 0%,
            #032d3e 52%,
            #012331 100%
        );

    border-radius: 24px;

    border:
        1px solid
        rgba(67,194,239,0.38);

    box-shadow:
        0 16px 40px
        rgba(0,0,0,0.28);

    overflow: hidden;
}


/* =========================================================
   HEADER
   ========================================================= */

.cost-header {

    display: flex;

    justify-content: space-between;

    align-items: center;

    padding-bottom: 20px;

    border-bottom:
        1px solid
        rgba(77,190,235,0.16);
}


.header-left {

    display: flex;

    align-items: center;

    gap: 14px;
}


.header-accent {

    width: 5px;

    height: 55px;

    border-radius: 6px;

    background: #55c7ff;
}


.header-title {

    font-size: 25px;

    font-weight: 900;

    letter-spacing: 1px;
}


.header-subtitle {

    margin-top: 5px;

    font-size: 14px;

    color: #9fc2d0;
}


/* =========================================================
   CONTEXT
   ========================================================= */

.context {

    text-align: right;
}


.context-label {

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.9px;

    color: #7faeba;
}


.context-value {

    margin-top: 3px;

    font-size: 15px;

    font-weight: 900;
}


.context-traveller {

    margin-top: 3px;

    font-size: 10px;

    color: #8eafbb;
}


/* =========================================================
   TOTAL SECTION
   ========================================================= */

.total-section {

    display: flex;

    align-items: center;

    justify-content: space-between;

    padding: 22px 0;

    border-bottom:
        1px solid
        rgba(77,190,235,0.15);
}


.total-left {

    display: flex;

    align-items: center;

    gap: 16px;
}


.total-icon {

    width: 66px;

    height: 66px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 17px;

    background:
        rgba(255,202,75,0.12);

    border:
        1px solid
        rgba(255,202,75,0.35);

    color: #ffd35c;

    font-size: 31px;

    font-weight: 900;
}


.total-label {

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 1px;

    color: #82afbf;
}


.total-value {

    margin-top: 2px;

    font-size: 39px;

    font-weight: 950;

    letter-spacing: -1px;
}


.total-caption {

    margin-top: 4px;

    font-size: 10px;

    color: #8eafbb;
}


/* =========================================================
   DRIVER BOX
   ========================================================= */

.driver-box {

    width: 170px;

    padding: 12px 15px;

    border-radius: 16px;

    background:
        rgba(255,255,255,0.04);

    border:
        1px solid
        rgba(255,255,255,0.09);
}


.driver-label {

    font-size: 8px;

    font-weight: 800;

    letter-spacing: 0.8px;

    color: #7faeba;
}


.driver-name {

    margin-top: 5px;

    font-size: 15px;

    font-weight: 900;

    color: #ffd35c;
}


.driver-value {

    margin-top: 3px;

    font-size: 20px;

    font-weight: 900;
}


.driver-value span {

    font-size: 9px;

    font-weight: 500;

    color: #8eafbb;
}


/* =========================================================
   BREAKDOWN
   ========================================================= */

.breakdown {

    padding: 16px 0;
}


.cost-row {

    display: flex;

    align-items: center;

    gap: 12px;

    padding: 8px 0;
}


.cost-icon {

    width: 38px;

    height: 38px;

    flex-shrink: 0;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 11px;

    font-size: 17px;

    font-weight: 900;
}


.flight-icon {

    background:
        rgba(77,194,239,0.12);

    color: #58caff;
}


.hotel-icon {

    background:
        rgba(195,151,255,0.12);

    color: #c59aff;
}


.food-icon {

    background:
        rgba(255,173,92,0.12);

    color: #ffb36a;
}


.transport-icon {

    background:
        rgba(75,218,173,0.12);

    color: #60e5b3;
}


.attraction-icon {

    background:
        rgba(255,210,82,0.12);

    color: #ffd45c;
}


.tax-icon {

    background:
        rgba(255,108,118,0.12);

    color: #ff858d;
}


/* =========================================================
   COST INFO
   ========================================================= */

.cost-info {

    flex: 1;

    min-width: 0;
}


.cost-name {

    margin-bottom: 6px;

    font-size: 11px;

    font-weight: 750;

    color: #c5d9df;
}


.cost-bar {

    width: 100%;

    height: 7px;

    border-radius: 10px;

    overflow: hidden;

    background:
        rgba(255,255,255,0.07);
}


.bar-fill {

    height: 100%;

    min-width: 3px;

    border-radius: 10px;
}


.flight-fill {

    background: #58caff;
}


.hotel-fill {

    background: #c59aff;
}


.food-fill {

    background: #ffb36a;
}


.transport-fill {

    background: #60e5b3;
}


.attraction-fill {

    background: #ffd45c;
}


.tax-fill {

    background: #ff858d;
}


/* =========================================================
   COST VALUE
   ========================================================= */

.cost-value {

    width: 85px;

    flex-shrink: 0;

    text-align: right;
}


.cost-value div {

    font-size: 15px;

    font-weight: 850;
}


.cost-value span {

    display: block;

    margin-top: 2px;

    font-size: 9px;

    color: #7faeba;
}


/* =========================================================
   INSIGHT
   ========================================================= */

.cost-insight {

    display: flex;

    align-items: center;

    gap: 13px;

    margin-top: 8px;

    padding: 15px;

    border-radius: 17px;

    background:
        rgba(255,202,75,0.07);

    border:
        1px solid
        rgba(255,202,75,0.20);
}


.insight-icon {

    width: 40px;

    height: 40px;

    display: flex;

    align-items: center;

    justify-content: center;

    border-radius: 11px;

    background:
        rgba(255,202,75,0.12);

    font-size: 19px;
}


.insight-content {

    flex: 1;
}


.insight-label {

    font-size: 8px;

    font-weight: 850;

    letter-spacing: 0.9px;

    color: #bda86c;
}


.insight-title {

    margin-top: 3px;

    font-size: 14px;

    font-weight: 900;

    color: #ffd45c;
}


.insight-description {

    margin-top: 4px;

    font-size: 9px;

    line-height: 1.45;

    color: #9fb7bf;
}


.insight-number {

    width: 65px;

    text-align: center;

    font-size: 23px;

    font-weight: 950;

    color: #ffd45c;
}


.insight-number span {

    display: block;

    margin-top: -2px;

    font-size: 7px;

    letter-spacing: 0.7px;

    color: #809faa;
}


</style>
"
